/docs/integration/*.json
/ios-app/docs/xcode-validation/
/ios-app/docs/background-runs/validation.txt
/ios-app/docs/siri-validation/*.json

# CoreDevice diagnostics, identities and build outputs stay local.
/coredevice/swift/.build/
/coredevice/swift/.swiftpm/
/coredevice/**/pairing*.plist
/coredevice/**/identity*.plist
/coredevice/**/screen*.png
/coredevice/**/screen*.hevc
/coredevice/rust/target/

# Keep captured screens and their manifests local; retain app assets and test fixtures.
/docs/**/*.png
/docs/**/*.jpg
/docs/**/*.jpeg
/ios-app/docs/**/*.png
/ios-app/docs/**/*.jpg

# Local handoff snapshots.
**/handoffs/

# Device build configuration and downloaded SDK components.
